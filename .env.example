# ─── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# ─── Gemini / Google AI Studio ────────────────────────────────────────────────
# Option A — Google AI Studio API key (no GCP service account needed for Gemini calls)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Option B — Vertex AI (leave GEMINI_API_KEY unset; uses Application Default Credentials)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GEMINI_MODEL=gemini-1.5-pro-001

# ─── Cloud Storage ────────────────────────────────────────────────────────────
GCS_BUCKET_RAW=your-project-raw-filings
GCS_BUCKET_RULESETS=your-project-rulesets

# ─── Firestore ────────────────────────────────────────────────────────────────
FIRESTORE_ANALYSIS_COLLECTION=case_analyses

# ─── BigQuery ─────────────────────────────────────────────────────────────────
BIGQUERY_DATASET=evictionshield

# ─── Pub/Sub ──────────────────────────────────────────────────────────────────
PUBSUB_TOPIC_ANALYSIS_DONE=case-analysis-complete

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
