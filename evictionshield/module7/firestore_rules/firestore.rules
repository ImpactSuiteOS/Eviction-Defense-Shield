// EvictionShield — Module 7B: Firestore Security Rules
//
// Enforcement model:
// - Legal aid organizations: read cases in their coverage area only
// - Tenants: read only their own case (authenticated by phone number via Firebase Auth)
// - Cloud Function service accounts: write via server SDK (bypasses these rules)
// - legal_aid_directory: publicly readable
//
// All writes from Cloud Functions use the Admin SDK which bypasses client rules.
// These rules govern only client-side SDK and REST API access.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper functions
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isServiceAccount() {
      // Service accounts have UID ending in @<project>.iam.gserviceaccount.com
      return request.auth != null &&
             request.auth.token.email.matches('.*@.*\\.iam\\.gserviceaccount\\.com');
    }

    function getUserOrgId() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.org_id;
    }

    function getUserCoverageZips() {
      let orgId = getUserOrgId();
      return get(/databases/$(database)/documents/legal_aid_orgs/$(orgId)).data.coverage_zip_codes;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role;
    }

    function isLegalAidUser() {
      return isAuthenticated() && getUserRole() in ['attorney', 'admin', 'read_only'];
    }

    function isAttorneyOrAdmin() {
      return isAuthenticated() && getUserRole() in ['attorney', 'admin'];
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function caseInOrgCoverage(caseDoc) {
      let zipCodes = getUserCoverageZips();
      return caseDoc.data.zip_code in zipCodes;
    }

    function isTenantOwner(caseDoc) {
      // Tenants authenticate via phone number — Firebase Auth phone claim
      return isAuthenticated() &&
             request.auth.token.phone_number != null &&
             caseDoc.data.get('tenant_phone_hash', '') ==
               hashing.md5(bytes(request.auth.token.phone_number)).toBase64String();
    }


    // =========================================================================
    // eviction_filings — raw extracted fields from Document AI
    // =========================================================================
    match /eviction_filings/{caseId} {
      // Legal aid users: read if case is in their coverage area
      allow read: if isLegalAidUser() && caseInOrgCoverage(get(/databases/$(database)/documents/eviction_filings/$(caseId)));

      // Tenants: read only their own case
      allow read: if isTenantOwner(get(/databases/$(database)/documents/eviction_filings/$(caseId)));

      // Writes: service accounts only (Cloud Functions)
      allow write: if isServiceAccount();

      // No client-side deletes (deletions handled by retention job service account)
    }


    // =========================================================================
    // case_analyses — Gemini analysis results
    // =========================================================================
    match /case_analyses/{caseId} {
      // Legal aid users: read cases in coverage area
      allow read: if isLegalAidUser() &&
                     resource.data.zip_code in getUserCoverageZips();

      // Tenants: read their own case analysis (same phone hash check)
      allow read: if isTenantOwner(get(/databases/$(database)/documents/eviction_filings/$(caseId)));

      // Writes: service accounts only
      allow write: if isServiceAccount();
    }


    // =========================================================================
    // case_outcomes — post-hearing outcomes recorded by attorneys
    // =========================================================================
    match /case_outcomes/{caseId} {
      // Attorneys and admins: read and write outcomes for cases in their coverage
      allow read: if isAttorneyOrAdmin() &&
                     get(/databases/$(database)/documents/case_analyses/$(caseId)).data.zip_code
                     in getUserCoverageZips();

      allow create, update: if isAttorneyOrAdmin() &&
                               get(/databases/$(database)/documents/case_analyses/$(caseId)).data.zip_code
                               in getUserCoverageZips() &&
                               // Validate required fields on write
                               request.resource.data.keys().hasAll(['case_number', 'outcome', 'recorded_at']) &&
                               request.resource.data.outcome in ['won', 'lost', 'settled', 'dismissed', 'no_show'];

      // Service accounts: write
      allow write: if isServiceAccount();
    }


    // =========================================================================
    // landlord_profiles — read-only for legal aid, write for analysis service
    // =========================================================================
    match /landlord_profiles/{landlordId} {
      // All authenticated legal aid users: read only
      allow read: if isLegalAidUser();

      // No direct client writes — only via service accounts
      allow write: if isServiceAccount();
    }


    // =========================================================================
    // legal_aid_directory — publicly readable (tenants need to find help)
    // =========================================================================
    match /legal_aid_directory/{orgId} {
      allow read: if true;  // Public — no auth required
      allow write: if isAdmin();
    }


    // =========================================================================
    // legal_aid_orgs — org configuration (coverage areas, etc.)
    // =========================================================================
    match /legal_aid_orgs/{orgId} {
      // Each org's admins can read and update their own org config
      allow read: if isAuthenticated() && getUserOrgId() == orgId;
      allow update: if isAdmin() && getUserOrgId() == orgId;

      // Cross-org reads: service accounts only
      allow read: if isServiceAccount();
      allow write: if isServiceAccount();
    }


    // =========================================================================
    // user_profiles — each user reads their own profile; admins read all in org
    // =========================================================================
    match /user_profiles/{userId} {
      // Users read/update their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId &&
                       // Users cannot change their own role or org_id
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'org_id']);

      // Admins read all profiles in their org
      allow read: if isAdmin() &&
                     resource.data.org_id == getUserOrgId();

      // Service accounts: full access
      allow write: if isServiceAccount();
    }


    // =========================================================================
    // notification_events — write-only for notification service
    // =========================================================================
    match /notification_events/{eventId} {
      // Legal aid admins: read notification logs for cases in their coverage
      allow read: if isAdmin();

      // Service accounts: write
      allow write: if isServiceAccount();

      // No client deletes
    }


    // =========================================================================
    // tenant_intake_responses — tenants write their own; attorneys read
    // =========================================================================
    match /tenant_intake_responses/{caseId} {
      // Tenants: read and write their own intake responses
      allow read, write: if isTenantOwner(
        get(/databases/$(database)/documents/eviction_filings/$(caseId))
      );

      // Legal aid users: read intake for cases in their coverage
      allow read: if isLegalAidUser() &&
                     get(/databases/$(database)/documents/case_analyses/$(caseId)).data.zip_code
                     in getUserCoverageZips();

      // Service accounts: write
      allow write: if isServiceAccount();
    }


    // =========================================================================
    // ingestion_checkpoints — internal service state; no client access
    // =========================================================================
    match /ingestion_checkpoints/{adapterId} {
      allow read, write: if isServiceAccount();
    }


    // =========================================================================
    // analysis_reviews — legal review queue; admins only
    // =========================================================================
    match /analysis_reviews/{reviewId} {
      allow read: if isAdmin();
      allow update: if isAdmin() &&
                       // Can only set review_status and review_notes
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['review_status', 'review_notes', 'reviewed_by', 'reviewed_at']);
      allow write: if isServiceAccount();
    }


    // =========================================================================
    // manual_notification_queue — clerk workflow; admin access
    // =========================================================================
    match /manual_notification_queue/{caseId} {
      allow read, write: if isAdmin();
      allow write: if isServiceAccount();
    }


    // =========================================================================
    // call_transcripts — sensitive PII; restricted access
    // =========================================================================
    match /call_transcripts/{callSid} {
      // No client access — service accounts only
      allow read, write: if isServiceAccount();
    }


    // =========================================================================
    // callback_requests — intake coordination
    // =========================================================================
    match /callback_requests/{caseId} {
      allow read: if isAttorneyOrAdmin() &&
                     get(/databases/$(database)/documents/case_analyses/$(caseId)).data.get('zip_code', '')
                     in getUserCoverageZips();
      allow write: if isServiceAccount();
    }

  }
}
